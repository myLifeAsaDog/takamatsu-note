---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('articleCollection')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const openArticles = posts.filter((article) => article.data.category === 'develop');
---

<Layout title="" description="">
  <section>
    <h1>高松市の「再開発・まちづくり」情報一覧</h1>
    <ul>
      {
        openArticles.map((post) => (
          <li>
            <a href={`/open/${post.id}/`}>
              <h4 class="title">{post.data.title}</h4>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
