---
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import ImageLoader from '../components/ImageLoader.astro';
import FormattedDate from '../components/FormattedDate.astro';
import cameraImage from '../assets/images/ico_camera.png';

type Props = CollectionEntry<'articleCollection'>['data'] & { slug: string };
const props = Astro.props;

const optimizeImage = await getImage({
  src: cameraImage,
  width: 14,
  height: 14,
  format: 'webp',
  quality: 100,
});
const cameraIcon = `url(${optimizeImage.src})`;
---

<Layout title={`TAKAMATSU-NOTE | ${props.title}`} description="">
  <ol class="bread-crumbs">
    <li><a href="/">TOP</a></li>
    <li><a href={`/${props.category}`}>{props.category.toUpperCase()}</a></li>
    <li><a href={`/${props.category}/${props.slug}`}>{props.title}</a></li>
  </ol>
  <article>
    <div class="article-meta">
      <p class="category">{props.category.toUpperCase()}</p>
      <p class="category">{props.spot}</p>
      <FormattedDate date={props.publishDate} />
    </div>
    <h1>{props.title}</h1>
    <figure class="header-image">
      <ImageLoader url={props.image ?? ''} alt={props.title} />
      {props.credit && <figcaption>{props.credit}</figcaption>}
    </figure>
    <div class="article-body">
      <slot />
    </div>
  </article>
</Layout>

<style define:vars={{ cameraIcon }}>
  .article-meta {
    display: flex;
    align-items: center;
    margin: 0 0 20px 0;

    .category {
      margin: 0 10px 0 0;
      padding: 3px 10px;
      border-radius: 12px;
      font-size: 13px;
      line-height: 16px;
      background: var(--main-tory-blue);
      color: var(--main-white);
    }
    time {
      font-size: 13px;
    }
  }
  h1 {
    margin: 0 0 16px 0;
    font-size: 24px;
    font-weight: bold;
  }
  .header-image {
    position: relative;
    margin: 0 0 20px 0;

    figcaption {
      position: absolute;
      right: 0;
      bottom: 0;
      padding: 5px 10px;
      font-size: 13px;
      color: var(--main-white);
      background: rgba(0, 0, 0, 0.3);
    }
    figcaption::before {
      content: '';
      display: inline-block;
      width: 14px;
      height: 14px;
      margin: 0 3px 0 0;
      background-image: var(--cameraIcon);
      background-repeat: no-repeat;
      background-position: center left;
    }
  }
  .article-body {
    line-height: 1.5;

    h2 {
      margin: 10px 0;
      font-weight: bold;
    }
    p {
      margin: 0 0 1em 0;
    }
  }
</style>
